# GameZone Backend - Environment Variables
# Copy to .env and fill real values. NEVER commit .env or serviceAccountKey.json

PORT=3000

# Single admin (v1) - pick ONE option:
# Option A (easy, good for Render on phone): plain password
ADMIN_EMAIL=admin@gamezone.local
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Option B (safer): bcrypt hash instead of plain password
# Generate: npm run hash-password 'your-password'
# ADMIN_PASSWORD_HASH=$2a$10$REPLACE_WITH_REAL_BCRYPT_HASH

# JWT session
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_STRING
JWT_EXPIRES_IN=12h

# Firebase Admin SDK - pick ONE option:
# Option A (Render deploy): paste the WHOLE service account JSON in one line
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Option B (local): path to key file (gitignored, never commit)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
FIREBASE_PROJECT_ID=gamezone-5

# URL the Android app posts tokens to (dev example)
BACKEND_URL=http://10.0.2.2:3000

# CORS - comma separated allowed origins
CORS_ORIGINS=http://localhost:3000
